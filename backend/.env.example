# Copy to .env for reference. The app reads real environment variables;
# for local development none of these are required.

# "production" turns on the startup safety checks below.
ENVIRONMENT=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required in production. Postgres URL from your host, e.g.
#   postgresql://user:password@host:5432/clarity
# Local development defaults to a SQLite file (clarity_dev.db).
DATABASE_URL=

# Required in production. The frontend URL(s), comma separated, no trailing slash.
CORS_ORIGINS=https://your-app.vercel.app

# Optional. When set, signing up requires this code. Recommended for an invite-only alpha.
SIGNUP_CODE=

# Optional. Login lifetime in minutes (default 10080 = 7 days) and upload cap in bytes (default 10 MB).
# ACCESS_TOKEN_MINUTES=10080
# MAX_UPLOAD_BYTES=10485760
